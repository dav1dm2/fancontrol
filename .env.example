# Copy this file to .env and adjust values for your local services.
DB_URL=jdbc:postgresql://localhost:5432/fancontrol
DB_USERNAME=postgres
DB_PASSWORD=change-me
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=fancontrol-server
JPA_SHOW_SQL=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_SECONDS=3600
ADMIN_INITIAL_NAME=admin
ADMIN_INITIAL_PASSWORD=replace-this-local-admin-password
